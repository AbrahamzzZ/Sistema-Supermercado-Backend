@startuml clase_modulo_categoria
!include _estilo.iuml
!pragma layout smetana
title Diagrama de clases — Patrón de un módulo (Categoría)
hide empty members

class CategoriaController <<API · Controller>> {
  - _categoriaService : ICategoriaService
  + GetCategorias()
  + GetCategoriasPaginacion(pageNumber, pageSize, filtro)
  + GetCategoria(id)
  + RegistrarCategoria(categoria)
  + EditarCategoria(id, categoria)
  + EliminarCategoria(id)
}

interface ICategoriaService <<Infrastructure>> {
  + ListarCategoriasAsync()
  + ListarCategoriasPaginacionAsync(pageNumber, pageSize, filtro)
  + ObtenerCategoriaAsync(id)
  + RegistrarCategoriaAsync(Categorium)
  + EditarCategoriaAsync(Categorium)
  + EliminarCategoriaAsync(id)
}

class CategoriaService <<Infrastructure>> {
  - _categoriaRepository : ICategoriaRepository
  - _validator : IValidator<Categorium>
  - _currentUserService : ICurrentUser
  - _auditoriaService : IAuditoriaService
}

class CategoriaValidator <<FluentValidation>>
interface IAuditoriaService
interface ICurrentUser

interface ICategoriaRepository <<Infrastructure>> {
  + ListarCategoriasAsync() : List<CategoriaResponse>
  + ListarCategoriasPaginacionAsync(...) : Paginacion<CategoriaResponse>
  + ObtenerCategoriaAsync(id) : CategoriaResponse?
  + RegistrarCategoriaAsync(Categorium, usuarioCreacion) : int
  + EditarCategoriaAsync(Categorium, usuarioModificacion) : int
  + EliminarCategoriaAsync(id) : int
}

class CategoriaRepository <<Infrastructure>> {
  - _context : SistemaSupermercadoContext
}

class SistemaSupermercadoContext <<Domain · DbContext>>

class Categorium <<Domain · Entidad>> {
  + Id_Categoria : int
  + Codigo : string?
  + Nombre_Categoria : string?
  + Estado : bool?
  + Usuario_Creacion, Fecha_Creacion
  + Usuario_Modificacion, Fecha_Modificacion
}
class CategoriaResponse <<Domain · DTO>>

class "ApiResponse<T>" as ApiResponse <<Utilities>> {
  + IsSuccess : bool
  + Message : string?
  + Data : T?
}
class "Paginacion<T>" as Paginacion <<Utilities>> {
  + Items : List<T>
  + TotalCount : int
  + PageNumber : int
  + PageSize : int
}

CategoriaController -down-> ICategoriaService
CategoriaService .up.|> ICategoriaService
CategoriaService -right-> CategoriaValidator
CategoriaService -right-> IAuditoriaService
CategoriaService -right-> ICurrentUser
CategoriaService -down-> ICategoriaRepository
CategoriaRepository .up.|> ICategoriaRepository
CategoriaRepository -down-> SistemaSupermercadoContext
CategoriaValidator .down.> Categorium : valida
CategoriaService .left.> ApiResponse : devuelve
CategoriaRepository .down.> CategoriaResponse : mapea
CategoriaRepository .left.> Paginacion : construye
@enduml
