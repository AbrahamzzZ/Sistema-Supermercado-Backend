@startuml secuencia_login
!include _estilo.iuml
title Diagrama de secuencia — Inicio de sesión
autonumber
actor "Frontend" as FE
participant "UsuarioController" as UC
participant "UsuarioService" as US
participant "UsuarioRepository" as UR
participant "Encriptacion" as EN
participant "MenuService" as MS
participant "Token" as TK
participant "AuditoriaService" as AU
database "SQL Server" as DB

FE -> UC : POST /api/usuario/login\n{ correo_Electronico, clave }
UC -> US : IniciarSesionAsync(login)
alt correo o clave vacíos
  US -> AU : RegistrarFalloAsync
  US --> UC : IsSuccess = false
  UC --> FE : 401 «Correo y clave son obligatorios.»
else datos completos
  US -> UR : IniciarSesionAsync(login)
  UR -> EN : EncriptarSHA256(clave)
  EN --> UR : hash
  UR -> DB : EXEC PA_INICIAR_SESION @Correo, @Clave
  DB --> UR : usuario con rol, o vacío
  UR --> US : UsuarioRolResponse?
  alt usuario no encontrado
    US -> AU : RegistrarFalloAsync
    US --> UC : IsSuccess = false
    UC --> FE : 401 «Credenciales inválidas.»
  else usuario inactivo
    US -> AU : RegistrarFalloAsync
    US --> UC : IsSuccess = false
    UC --> FE : 401 «Usuario inactivo...»
  else usuario válido
    US -> AU : RegistrarExitoAsync
    US --> UC : IsSuccess = true, Data = usuario
    UC -> MS : ObtenerMenusAsync(idUsuario)
    MS -> DB : EXEC PA_OBTENER_MENU @Id_Usuario
    DB --> MS : menús del rol
    MS --> UC : List<Menu>
    UC -> TK : GenerarToken(usuario, menús)
    TK --> UC : JWT firmado (HMAC-SHA256)
    UC --> FE : 200 { token }
  end
end
@enduml
