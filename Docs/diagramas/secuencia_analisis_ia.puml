@startuml secuencia_analisis_ia
!include _estilo.iuml
title Diagrama de secuencia — Análisis con IA
autonumber
actor "Frontend" as FE
participant "NegocioController" as NC
participant "NegocioService" as NS
participant "Reglas" as RG
participant "Repositorios" as RP
database "SQL Server" as DB
participant "OllamaClient" as OC
participant "Servidor Ollama" as OL

FE -> NC : POST /api/negocio/analisis-ia\n{ "prompt": "..." }
NC -> NS : AnalisisIA(prompt)
NS -> RG : DetectarTipoAnalisis(prompt)
RG --> NS : TipoAnalisis
alt Invalido, Proveedor o Sucursal
  NS --> NC : IsSuccess = false
  NC --> FE : 400 «La pregunta no está relacionada con nada del negocio.»
else Producto, Categoria, Cliente, Comprado o Vendido
  NS -> RP : consulta según el tipo
  RP -> DB : PA_LISTA_PRODUCTO, PA_LISTA_CATEGORIA,\nPA_TOP_CLIENTES o PA_TENDENCIA_*
  DB --> RP : filas
  RP --> NS : datos
  NS -> NS : armar prompt\n"Analiza estos datos y responde en máximo 3 líneas..."
  NS -> OC : GenerateAsync(prompt)
  OC -> OL : POST /api/generate\n(model phi3.5, stream = false, num_predict = 50)
  alt Ollama responde
    OL --> OC : { response }
    OC --> NS : texto generado
  else error o sin conexión
    OC --> NS : "Error conectando a Ollama: ..."
  end
  NS --> NC : IsSuccess = true, Data = texto
  NC --> FE : 200 «Análisis generado exitosamente.»
end
@enduml
