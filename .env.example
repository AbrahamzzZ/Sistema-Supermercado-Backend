# Copiar este archivo como ".env" (en la raíz del repositorio) y completar los valores.

# Cadena de conexión a SQL Server, vista desde el contenedor
# (usar la IP o el nombre del servidor, no "localhost" ni "(localdb)")
DB_CONNECTION_STRING=Data Source=CADENA_CONEXION;Initial Catalog=Sistema_Supermercado;User Id=USUARIO;Password=CLAVE;TrustServerCertificate=True;

# Clave para firmar los tokens JWT (mínimo 32 caracteres)
JWT_KEY=

# Modelo de Ollama: lo descarga el contenedor "ollama" y lo usa la API
OLLAMA_MODEL=phi3.5
